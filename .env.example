# ==============================================================================
# Raphael AI — Environment Configuration
# Copy this file to .env.local and fill in your credentials
# ==============================================================================

# Supabase (Database, Auth, Storage & pgvector)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Embedding & Primary LLM Provider
# Gemini API Key is required for generating 768-dim embeddings
GEMINI_API_KEY=your-gemini-api-key

# Optional LLM Inference Providers (Cascading Fallback)
GROQ_API_KEY=your-groq-api-key
OPENROUTER_API_KEY=your-openrouter-api-key

# Active LLM Provider Priority: 'groq' | 'gemini' | 'openrouter' (default: groq)
LLM_PROVIDER=groq
